{
  "name": "agoa-rv",
  "productName": "AGOA PV",
  "version": "0.11.0",
  "description": "AGOA PV — suivi de chantier et procès-verbaux de réunion",
  "author": "SELARL Rémi Thollet Architecte",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/agence-rt/agoa-rv.git"
  },
  "private": true,
  "main": "main.js",
  "agoa": {
    "deploiement": 11
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "deploy": "node scripts/deploy.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.remithollet.agoarv",
    "productName": "AGOA PV",
    "artifactName": "AGOA-PV-Setup-${version}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AGOA PV",
      "runAfterFinish": true,
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "multiLanguageInstaller": false,
      "deleteAppDataOnUninstall": false
    },
    "fileAssociations": [
      {
        "ext": "pv",
        "name": "Dossier PV",
        "description": "Dossier de suivi de chantier AGOA (PV)",
        "icon": "pv",
        "role": "Editor"
      },
      {
        "ext": "agoarv",
        "name": "Dossier PV (ancien format)",
        "description": "Dossier de suivi de chantier AGOA (ancien format)",
        "icon": "pv",
        "role": "Editor"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "agence-rt",
        "repo": "agoa-rv",
        "releaseType": "release"
      }
    ]
  }
}
