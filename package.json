{
  "name": "agoa-rv",
  "productName": "AGOA PV",
  "version": "0.19.0",
  "description": "AGOA PV — suivi de chantier et procès-verbaux de réunion",
  "author": "SELARL Rémi Thollet Architecte",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/agence-rt/agoa-rv.git"
  },
  "private": true,
  "main": "main.js",
  "agoa": {
    "deploiement": 19,
    "google": {
      "clientId": "253318887290-luk51sg4fnsg7552foru42v8v8nmrnfj.apps.googleusercontent.com",
      "clientSecret": "",
      "allowed": [
        "4c62e33b6805a68d47650fc52009f5cd15c30eb94c0eb44700c8d235c186044a"
      ]
    }
  },
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win",
    "deploy": "node scripts/deploy.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "fr.remithollet.agoarv",
    "productName": "AGOA PV",
    "artifactName": "AGOA-PV-Setup-${version}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "login-preload.js",
      "app/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "include": "build/installer.nsh",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "AGOA PV",
      "runAfterFinish": true,
      "installerLanguages": [
        "fr_FR"
      ],
      "language": "1036",
      "multiLanguageInstaller": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "artifactName": "AGOA-PV-${version}-mac.${ext}",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "AGOA PV ${version}",
      "artifactName": "AGOA-PV-${version}-mac.${ext}"
    },
    "fileAssociations": [
      {
        "ext": "pv",
        "name": "Dossier PV",
        "description": "Dossier de suivi de chantier AGOA (PV)",
        "icon": "pv",
        "role": "Editor"
      },
      {
        "ext": "agoarv",
        "name": "Dossier PV (ancien format)",
        "description": "Dossier de suivi de chantier AGOA (ancien format)",
        "icon": "agoarv",
        "role": "Editor"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "agence-rt",
        "repo": "agoa-rv",
        "releaseType": "release"
      }
    ]
  }
}
